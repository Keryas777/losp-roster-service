{
  "name": "losp-roster-service",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "vars": {
    "CAPTAIN_SESSIONS_ENABLED": "true",
    "CAPTAIN_COVERAGE_ENABLED": "false",
    "MSF_ADMIN_ENABLED": "true"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "none"
  },
  "r2_buckets": [
    { "binding": "CAPTAIN_BUCKET", "bucket_name": "losp-roster-sessions" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CAPTAIN_REFRESH_COORDINATOR", "class_name": "CaptainRefreshCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "captain-oauth-v1", "new_sqlite_classes": ["CaptainRefreshCoordinator"] }
  ],
  "triggers": {
    "crons": ["15 * * * *", "15 3 * * *"]
  }
}
