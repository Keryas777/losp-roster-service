{
  "name": "losp-roster-service",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "CAPTAIN_SESSIONS_ENABLED": "true",
    "CAPTAIN_COVERAGE_ENABLED": "false",
    "MSF_ADMIN_ENABLED": "true",
    "ROSTER_AUTO_ENABLED": "true",
    "PLAYER_AUTO_ENABLED": "true",
    "ROSTER_RETENTION_CONFIRMED": "true",
    "GAME_ARCHIVE_AUTO_ENABLED": "true",
    "GAME_DIFF_ENABLED": "true",
    "GAME_ARCHIVE_PHASE2_ENABLED": "true",
    "GAME_ARCHIVE_RECOVERY_ENABLED": "true"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "none"
  },
  "r2_buckets": [
    { "binding": "CAPTAIN_BUCKET", "bucket_name": "losp-roster-sessions" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CAPTAIN_REFRESH_COORDINATOR", "class_name": "CaptainRefreshCoordinator" },
      { "name": "ROSTER_BATCH_LOCK", "class_name": "RosterBatchLock" }
    ]
  },
  "migrations": [
    { "tag": "captain-oauth-v1", "new_sqlite_classes": ["CaptainRefreshCoordinator"] },
    { "tag": "roster-batch-v1", "new_sqlite_classes": ["RosterBatchLock"] }
  ],
  "triggers": {
    "crons": ["15 * * * *", "15 3 * * *", "* 2-5,14-17 * * *", "* * * * *", "*/2 * * * *"]
  }
}
